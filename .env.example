# Copy to .env. Never commit the real .env file.
PORT=3000
# Required when NODE_ENV=production. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
# Supabase connection string: Supabase dashboard > Connect > "Session pooler".
# Replace [YOUR-PASSWORD] with your database password (URL-encode special characters, e.g. @ becomes %40).
# Leave this line commented out for local development: the app then uses a local database in the data/ folder.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres
CLINIC_TZ=Asia/Manila
# Set to true when the site is served over HTTPS (cookies become Secure, HSTS enabled).
COOKIE_SECURE=false
# Set to true if running behind a proxy such as Render or Nginx.
TRUST_PROXY=false
# Set to true for the first start on an empty production database to create the demo accounts. Remove it afterwards.
SEED_DEMO=false
